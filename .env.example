# =============================================================================
# Playwright Enterprise Framework — environment template
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in locally. `.env` is git-ignored; this file is NOT.
# NEVER put a real credential in this file — it is committed and public.
# In CI, set every secret below as a repository/organisation secret instead.
# Validate everything with:  npm run integrations:doctor
# =============================================================================

# ---- Target ------------------------------------------------------------------
# dev | qa | uat | prod | demoshop   (see config/environments/*.json)
TEST_ENV=dev
# Optional overrides of the environment file
# BASE_URL=https://vhc-healthcarefe.vercel.app
# API_BASE_URL=

# ---- Execution ---------------------------------------------------------------
HEADLESS=false
WORKERS=4
RETRIES=0
SLOW_MO=0
LOG_LEVEL=INFO
EXTENT_REPORT=true
REUSE_AUTH_STATE=true
DEMO_APP_PORT=4321

# ---- Application credentials (per role) --------------------------------------
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# MANAGER_USERNAME=
# MANAGER_PASSWORD=
# EMPLOYEE_USERNAME=
# EMPLOYEE_PASSWORD=
# API_KEY=

# ---- Reporting ---------------------------------------------------------------
# Public link to the published report (CI artifact / Pages URL). Used in Slack, email, Jira.
# REPORT_URL=

# =============================================================================
# INTEGRATIONS — every one is OFF until its variables are set.
# =============================================================================
# Master kill-switch (true = no outbound calls at all, e.g. for local debugging)
INTEGRATIONS_DISABLED=false
# Restrict to a subset, comma separated: jira,zephyr,sauce,slack,email
# INTEGRATIONS_ONLY=
# Wall-clock budget per publishing phase (ms)
# INTEGRATIONS_BUDGET_MS=120000

# ---- Jira Cloud --------------------------------------------------------------
JIRA_ENABLED=false
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PAY
# Only scoped API tokens need this
# JIRA_CLOUD_ID=
# Only write to these project prefixes (stops @CHROME-131 being read as an issue key)
JIRA_ISSUE_KEY_PREFIXES=PAY
# File a Bug for failures that reference no issue
JIRA_CREATE_ISSUE_ON_FAILURE=false
# per-test = one de-duplicated Bug per failing test (recommended for CI)
# run      = one Bug per run listing every unlinked failure (legacy)
JIRA_BUG_MODE=per-test
JIRA_ISSUE_TYPE=Bug
# Attach the failure screenshot to newly created Bugs
JIRA_ATTACH_SCREENSHOTS=true
# Comment on open auto-filed Bugs whose test passes again
JIRA_NOTE_RECOVERIES=true
# Extra labels on created Bugs (comma separated)
# JIRA_LABELS=regression,automation
# Hard cap on Jira API calls per run
JIRA_MAX_COMMENTS=20

# ---- Zephyr Scale Cloud ------------------------------------------------------
ZEPHYR_ENABLED=false
ZEPHYR_API_TOKEN=
ZEPHYR_PROJECT_KEY=PAY
# us (default) or EU: https://eu.api.zephyrscale.smartbear.com/v2
# ZEPHYR_BASE_URL=https://api.zephyrscale.smartbear.com/v2
# Append to an existing cycle, or let the framework create one per run
# ZEPHYR_TEST_CYCLE_KEY=PAY-R12
# ZEPHYR_TEST_CYCLE_NAME=Nightly regression
# ZEPHYR_ENVIRONMENT_NAME=QA

# ---- Slack -------------------------------------------------------------------
# Incoming-webhook URL — it IS the credential, keep it secret
SLACK_WEBHOOK_URL=
# failure (default) | always
SLACK_NOTIFY_ON=failure

# ---- Email (SMTP) ------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# true for port 465 (implicit TLS); STARTTLS is used automatically on 587
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="QA Automation <qa-automation@company.com>"
EMAIL_TO=qa-team@company.com
# EMAIL_CC=
# EMAIL_BCC=
# always (default) | failure
EMAIL_NOTIFY_ON=always
EMAIL_SUBJECT_PREFIX=[Playwright]
# Attach the self-contained HTML report (skipped above EMAIL_MAX_ATTACHMENT_MB)
EMAIL_ATTACH_REPORT=true
EMAIL_MAX_ATTACHMENT_MB=10

# ---- Sauce Labs --------------------------------------------------------------
# Get these from Sauce Labs → Account → User Settings. Never commit them.
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
# us-west-1 | us-east-4 | eu-central-1
SAUCE_REGION=eu-central-1
SAUCE_BUILD_NAME=Playwright-Enterprise
# SAUCE_TUNNEL_NAME=
