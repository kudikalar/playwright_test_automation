{
  "name": "playwright-enterprise-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade Playwright + TypeScript UI / API / Hybrid test automation platform",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "playwright test --project=api --project=chromium",
    "test:ui": "playwright test --project=chromium tests/ui",
    "test:api": "playwright test --project=api",
    "test:hybrid": "playwright test --project=chromium tests/hybrid",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:functional": "playwright test --project=api --project=chromium --grep @forgotpassword",
    "test:sanity": "playwright test --project=chromium --grep @sanity",
    "test:regression": "playwright test --project=api --project=chromium --grep @regression",
    "test:e2e": "playwright test --project=chromium --grep @e2e",
    "test:critical": "playwright test --project=api --project=chromium --grep @critical",
    "test:negative": "playwright test --project=api --project=chromium --grep @negative",
    "test:contract": "playwright test --project=api tests/api/contract",
    "test:dev": "cross-env TEST_ENV=dev playwright test --project=api --project=chromium",
    "test:qa": "cross-env TEST_ENV=qa playwright test --project=api --project=chromium",
    "test:uat": "cross-env TEST_ENV=uat playwright test --project=api --project=chromium",
    "test:prod": "cross-env TEST_ENV=prod playwright test --project=api --project=chromium --grep @smoke",

    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:edge": "playwright test --project=edge",
    "test:tablet": "playwright test --project=tablet-ipad",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:all-browsers": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:headed": "playwright test --headed --grep @e2e",
    "test:debug": "cross-env PWDEBUG=1 playwright test --debug --workers=1",
    "test:ui-mode": "playwright test --ui",
    "test:failed": "playwright test --last-failed",
    "report": "playwright show-report reports/playwright",
    "report:open": "node scripts/open-extent-report.mjs",
    "trace": "playwright show-trace",
    "demo-app": "node demo-app/server.mjs",
    "clean": "node scripts/clean.mjs",
    "verify": "node scripts/verify-framework.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,mts,js,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,js,mjs,json,md,yml}\"",
    "typecheck": "tsc --noEmit",
    "prepare:browsers": "cross-env PLAYWRIGHT_DOWNLOAD_CONNECTION_TIMEOUT=180000 playwright install --with-deps",
    "test:full": "playwright test",
    "test:security": "playwright test --project=api --grep @security",
    "sauce:config": "node --experimental-strip-types scripts/write-sauce-config.mts",
    "test:sauce": "node scripts/sauce-run.mjs --config .sauce/config.yml",
    "test:sauce:demoshop": "node scripts/sauce-run.mjs --config .sauce/config.yml --select-suite \"Demoshop Chrome - Windows 11\"",
    "test:demoshop": "cross-env TEST_ENV=demoshop playwright test --project=demoshop",
    "test:forgotpassword": "cross-env TEST_ENV=demoshop playwright test --project=chromium --grep @forgotpassword"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.10.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.2.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
